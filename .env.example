# Copie para .env (desenvolvimento) e ajuste os valores.
# .env é ignorado pelo git. Em produção (GitHub Pages), use .env.production.

# Supabase (público: URL + anon key ficam no front)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# ImgBB (NUNCA exponha no front em produção: em dev serve o proxy do Vite)
IMGBB_API_KEY=sua-chave-imgbb

# URL do GAS de upload (veja gas/upload.js). Deixe vazio em dev para usar o proxy ImgBB.
VITE_UPLOAD_URL=https://script.google.com/macros/s/SEU_GAS/exec
# Token compartilhado com o GAS (propriedade UPLOAD_TOKEN do script). Opcional: se o GAS
# não tiver UPLOAD_TOKEN configurado, qualquer valor aqui é ignorado.
VITE_UPLOAD_TOKEN=defina-um-token-igual-no-gas

# URL do GAS de cobrança/webhook (veja gas/billing-webhook.js). Deixe vazio para ocultar o botão.
# Se você colou gas/all-in-one.js num projeto único, use a MESMA URL do VITE_UPLOAD_URL aqui.
VITE_BILLING_URL=https://script.google.com/macros/s/SEU_GAS_BILLING/exec

# Analytics leve (Umami). Opcional; deixe vazio para desativar.
VITE_UMAMI_ID=
VITE_UMAMI_URL=https://cloud.umami.is/script.js
